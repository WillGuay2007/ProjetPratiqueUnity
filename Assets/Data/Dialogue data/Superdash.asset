  m_Script: {fileID: 11500000, guid: 51d814b7c213fff4bad299bc82408235, type: 3}
  m_Name: Superdash
  m_EditorClassIdentifier: 
  m_dialogueLines:
  - text: Do a super dash by dashing right on the ground (Only hold d) and then hold
      jump!
    strategyType: 0
  - text: Super dash is useful when you want to do a short distance dash with great
      jump power.
    strategyType: 0
  - text: If you dash normally, you will hit your head.
    strategyType: 0
  - text: If you try to simply jump and then dash sideway, you also won't have enough
      height.
    strategyType: 0
