  m_Script: {fileID: 11500000, guid: 51d814b7c213fff4bad299bc82408235, type: 3}
  m_Name: Dialogue1
  m_EditorClassIdentifier: 
  m_dialogueLines:
  - text: You will need to wall bounce by holding a + jump (only when sliding, not
      climbing)
    strategyType: 0
  - text: You will also need to hold L again when you reach the wall after the head
      hitter!
    strategyType: 0
  - text: From now on, apply what you've learned.
    strategyType: 0
  - text: No more spoonfeeding unless it's a new mechanic.
    strategyType: 0
  - text: You will still need to have problem solving skills to figure out the way!
    strategyType: 0
